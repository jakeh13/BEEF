#!/bin/bash

#SBATCH -J dilation_sweep
#SBATCH --account=gts-sr108-ece
#SBATCH -N 4 --ntasks-per-node=24
#SBATCH --mem-per-cpu=8G
#SBATCH -t 120
#SBATCH -q inferno
#SBATCH -o ../reports/%A_%a.out
#SBATCH --mail-type=FAIL
#SBATCH --array=0-10
